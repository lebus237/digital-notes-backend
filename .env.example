TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=<generate-with-adonis-generate-key>
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# DB_DRIVER selects the connection:
#   neon     → uses DATABASE_URL (Neon serverless Postgres, TLS required)
#   postgres → uses the discrete DB_* values below (default)
DB_DRIVER=postgres
# TLS for the Postgres connection:
#   false (default) → no TLS
#   true            → TLS with certificate verification
#   no-verify       → TLS without certificate verification (self-signed certs)
DB_SSL=false

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<database-password>
DB_DATABASE=digital_notes

# Neon (DB_DRIVER=neon) — written by `neon env pull` / kept in .env.local
# DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
# NEON_BRANCH=development

DRIVE_DISK=fs

STORAGE_PROVIDER=LOCAL
STORAGE_BASE_PATH=uploads
LOCAL_STORAGE_PATH=./storage
LOCAL_STORAGE_URL=http://localhost:3333/uploads

RAILWAY_STORAGE_ENDPOINT=
RAILWAY_STORAGE_ACCESS_KEY_ID=
RAILWAY_STORAGE_SECRET_ACCESS_KEY=
RAILWAY_STORAGE_BUCKET=
RAILWAY_STORAGE_REGION=

# --- Neon object storage (STORAGE_PROVIDER=NEON) ----------------------------
# Buckets are declared in neon.ts and provisioned per branch with `neon deploy`.
# AWS_* is the standard set `neon env pull` writes (branch-scoped credentials).
# Inject the credentials through the deploy environment; never commit them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=https://<endpoint>.storage.<region>.aws.neon.tech
# AWS_REGION=us-east-2
NEON_STORAGE_BUCKET=media
NEON_DOCS_STORAGE_BUCKET=docs

# Fallback sub-paths. Overridden per upload by the optional
# `storagePath` payload field (StoragePath enum: images | documents).
IMAGE_STORAGE_BASE_PATH=images
DOCUMENT_STORAGE_BASE_PATH=documents

MAX_FILE_SIZE_MB=2
ALLOWED_IMAGE_FORMATS=image/jpeg,image/png,image/webp
ALLOWED_DOCUMENT_FORMATS=application/pdf,application/msword

CORS_ORIGINS=http://localhost:3000
LIMITER_STORE=memory
