meta {
  name: Admin Reset Password
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/admin/users/:id/reset-password
  body: none
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

tests {
  test("should return 201 on success", function() {
    expect(res.status).toBe(201);
  });

  test("should return temporary password", function() {
    expect(res.body.data.temporaryPassword).toBeTruthy();
  });
}
