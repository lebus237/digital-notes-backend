meta {
  name: Create Faculty
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/admin/faculties
  body: json
  auth: inherit
}

body:json {
  {
    "universityId": "00000000-0000-0000-0000-000000000000",
    "name": "Faculty of Science",
    "slug": "faculty-of-science"
  }
}

tests {
  test("should return 201 on success", function() {
    expect(res.status).toBe(201);
  });

  test("should return created id", function() {
    expect(res.body.id).toBeTruthy();
  });
}
