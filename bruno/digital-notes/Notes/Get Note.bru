meta {
  name: Get Note
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/notes/:id
  body: none
  auth: inherit
}

params:path {
  id: 67a51e28-a88e-4aac-86fa-6f5361654a28
}

tests {
  test("should return 200 on success", function() {
    expect(res.status).toBe(200);
  });
  
  test("should return ordered pages", function() {
    if (Array.isArray(res.body.pages) && res.body.pages.length > 1) {
      const orders = res.body.pages.map((p) => p.sortOrder);
      expect(orders).toEqual([...orders].sort((a, b) => a - b));
    }
  });
}

docs {
  Returns a note with its ordered pages[] (each page: id, uploadId,
  url, mimeType, size, sortOrder). Unpublished notes require an
  administrator token.
}
