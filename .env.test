TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
NODE_ENV=test
APP_KEY=test_app_key_used_only_by_the_unit_suite

# The unit suite never connects to a database or an object store: the media
# upload service and repository bindings are skipped when NODE_ENV=test
# (see providers/service_provider.ts), so only the validated variables below
# are required to boot the app. AdonisJS skips .env.local for NODE_ENV=test,
# which is why these values live here instead.

DRIVE_DISK=fs
STORAGE_PROVIDER=LOCAL
STORAGE_BASE_PATH=uploads
LOCAL_STORAGE_PATH=./storage
LOCAL_STORAGE_URL=http://localhost:3333/uploads
